# Copy to `.env` and fill in. `.env` is gitignored — never commit a real key.
# Leaving the key empty is valid: the app runs in degraded (deterministic) mode.
# Get a key at https://console.groq.com/keys
GROQ_API_KEY=

# Optional overrides — defaults shown (architecture §10). Uncomment to change.
# MODEL=openai/gpt-oss-120b   (or qwen/qwen3.6-27b)
# LLM_CANDIDATE_K=25
# DEFAULT_TOP_N=5
# MIN_CANDIDATES=10
# MAX_CHAIN_OUTLETS=2
# RANK_WEIGHTS__RATING=0.45
# RANK_WEIGHTS__VOTES=0.20
# RANK_WEIGHTS__CUISINE=0.20
# RANK_WEIGHTS__BUDGET=0.15
# LLM_TIMEOUT_S=30
# ENABLE_SEMANTIC_SEARCH=false
# Groq rate limits for MODEL (console → Settings → Limits). Calls that won't fit wait up to
# LLM_RATE_LIMIT_MAX_WAIT_S, then fall back to the deterministic ranker.
# LLM_REQUESTS_PER_MINUTE=30
# LLM_REQUESTS_PER_DAY=1000
# LLM_TOKENS_PER_MINUTE=8000
# LLM_TOKENS_PER_DAY=200000
# LLM_RATE_LIMIT_MAX_WAIT_S=10
# Response cache: identical requests within the TTL are answered without a new LLM call.
# RESPONSE_CACHE_ENABLED=true
# RESPONSE_CACHE_TTL_S=3600
# RESPONSE_CACHE_MAX_ENTRIES=512
# API_REQUESTS_PER_MINUTE=10   (per client address, POST /recommend only)
# CATALOG_PATH=data/processed/restaurants.parquet
# API_URL=http://localhost:8000   (where the Streamlit UI finds the API)
# LOG_LEVEL=INFO
